{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C play dev",
    "build": "pnpm -C packages/vue-form-craft build",
    "small-v": "pnpm -C packages/vue-form-craft v",
    "release": "pnpm -C packages/vue-form-craft release",
    "release:docs": "pnpm -C docs release",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "change": "changeset",
    "change-v": "changeset version",
    "test": "vitest --config ./vitest.config.ts",
    "clear": "find . -type d -name 'node_modules' -exec rm -rf {} \\;"
  },
  "dependencies": {
    "element-plus": "^2.9.10",
    "lodash": "^4.17.21",
    "naive-ui": "^2.41.0",
    "vue": "^3.5.13",
    "vuedraggable-es-fix": "^1.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.3",
    "@rushstack/eslint-patch": "^1.11.0",
    "@tsconfig/node20": "^20.1.5",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.15.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue-form-craft/components": "workspace:*",
    "@vue-form-craft/config": "workspace:*",
    "@vue-form-craft/elements": "workspace:*",
    "@vue-form-craft/form-design": "workspace:*",
    "@vue-form-craft/form-render": "workspace:*",
    "@vue-form-craft/hooks": "workspace:*",
    "@vue-form-craft/icons": "workspace:*",
    "@vue-form-craft/styles": "workspace:*",
    "@vue-form-craft/types": "workspace:*",
    "@vue-form-craft/utils": "workspace:*",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/shared": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "sass": "~1.87.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "vue-form-craft": "workspace:*"
  }
